{
  "repository": {
    "type": "git",
    "url": "https://github.com/mathematic-inc/earl.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "build:site": "turbo run build --filter=site",
    "build:web": "turbo run build --filter=earl-web",
    "check": "oxlint --deny-warnings . && oxfmt --check .",
    "dev": "turbo run dev --parallel",
    "dev:site": "turbo run dev --filter=site",
    "dev:web": "turbo run dev --filter=earl-web",
    "fix": "oxlint --fix --deny-warnings . && oxfmt --write .",
    "format": "oxfmt --write .",
    "lint": "oxlint --deny-warnings .",
    "prepare": "if [ -z \"$CI\" ] && command -v hk >/dev/null 2>&1; then hk install; fi",
    "types:check": "turbo run types:check"
  },
  "devDependencies": {
    "turbo": "catalog:"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
